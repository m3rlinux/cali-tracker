rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Keep in sync with firebase-config.js → adminEmails
    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'm3rlinux.it@gmail.com'
      ];
    }
    function isApprovedOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.status == 'approved';
    }
    function roleOf(data) {
      return data.get('role', 'athlete');
    }
    function createRoleOk() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'athlete';
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && createRoleOk()
        && (request.resource.data.status == 'pending'
            || (isAdmin() && request.resource.data.status == 'approved'));
      allow update: if isAdmin()
        || (isApprovedOwner(userId)
            && request.resource.data.status == resource.data.status
            && request.resource.data.email == resource.data.email
            && roleOf(request.resource.data) == roleOf(resource.data));
      allow delete: if false;
    }

    match /users/{userId}/state/{docId} {
      allow read, write: if isApprovedOwner(userId);
    }
  }
}
